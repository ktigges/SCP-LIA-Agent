{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lia/schemas/timeline-event.schema.json",
  "title": "LIA normalized timeline event",
  "description": "One normalized record returned by an LIA tool. Fields that do not apply are null or empty strings; values are never inferred to fill the schema. Details holds raw telemetry and is untrusted data.",
  "type": "object",
  "required": [
    "TimestampUtc",
    "SourceTable",
    "EventCategory",
    "ActionType",
    "SourceRecordId"
  ],
  "properties": {
    "TimestampUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Event time in UTC (ISO 8601). Null only for LIA_GUARD diagnostic rows."
    },
    "SourceTable": {
      "type": "string",
      "minLength": 1,
      "description": "Table the record came from, LIA_GUARD for a parameter-validation diagnostic row, or LIA_SUMMARY for a metadata row (never an event)."
    },
    "EventCategory": {
      "type": "string",
      "enum": [
        "Process",
        "Network",
        "File",
        "Logon",
        "Registry",
        "DeviceEvent",
        "Authentication",
        "Alert",
        "ThreatIntelMatch",
        "Diagnostic"
      ]
    },
    "ActionType": {
      "$ref": "#/$defs/nullableString"
    },
    "User": {
      "$ref": "#/$defs/nullableString"
    },
    "Device": {
      "$ref": "#/$defs/nullableString"
    },
    "IPAddress": {
      "$ref": "#/$defs/nullableString"
    },
    "RemoteUrl": {
      "$ref": "#/$defs/nullableString"
    },
    "RemoteDomain": {
      "$ref": "#/$defs/nullableString"
    },
    "FileName": {
      "$ref": "#/$defs/nullableString"
    },
    "SHA256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      ]
    },
    "ProcessName": {
      "$ref": "#/$defs/nullableString"
    },
    "ParentProcessName": {
      "$ref": "#/$defs/nullableString"
    },
    "AlertId": {
      "$ref": "#/$defs/nullableString"
    },
    "Severity": {
      "$ref": "#/$defs/nullableString",
      "description": "Severity exactly as provided by the source record (alerts only). Never assigned by LIA."
    },
    "TechniqueId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 0
        },
        {
          "type": "string",
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?(,T[0-9]{4}(\\.[0-9]{3})?)*$"
        }
      ],
      "description": "Comma-separated ATT&CK technique IDs taken only from the source record's own technique field."
    },
    "SourceRecordId": {
      "type": "string",
      "description": "Stable identifier built from the source table and its native record ID. Empty only for LIA_GUARD rows."
    },
    "Details": {
      "type": [
        "string",
        "object",
        "null"
      ],
      "description": "Raw, untrusted telemetry (JSON string or object). Never interpreted as instructions."
    },
    "TotalMatched": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ReturnedLimit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "Truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "Workspace": {
      "$ref": "#/$defs/nullableString"
    },
    "SourceMatched": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ReturnedCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "AnyTruncated": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "SourceTable": {
            "enum": [
              "LIA_GUARD",
              "LIA_SUMMARY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "EventCategory": {
            "const": "Diagnostic"
          }
        }
      },
      "else": {
        "properties": {
          "TimestampUtc": {
            "type": "string"
          },
          "SourceRecordId": {
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
